{
    "name": "tailfin",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "typecheck": "tsc --noEmit",
        "test": "bunx --bun vitest run",
        "test:watch": "bunx --bun vitest",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "devEngines": {
        "packageManager": {
            "name": "pnpm",
            "version": "12.3.4",
            "onFail": "download"
        }
    },
    "packageManager": "pnpm@12.3.4",
    "devDependencies": {
        "@types/bun": "^1.4.1",
        "prettier": "^3.9.6",
        "typescript": "^7.0.2",
        "vitest": "^5.0.0"
    }
}
